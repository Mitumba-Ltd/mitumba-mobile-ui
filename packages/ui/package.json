{
  "name": "@mitumba/mobile-ui",
  "version": "0.2.0",
  "description": "Mitumba's native design and interaction system for React Native and Expo.",
  "license": "MIT",
  "type": "module",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitumba-Ltd/mitumba-mobile-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Mitumba-Ltd/mitumba-mobile-ui/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Mitumba-Ltd/mitumba-mobile-ui/issues"
  },
  "keywords": [
    "mitumba",
    "react-native",
    "expo",
    "design-system",
    "ui-components"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "node ../../scripts/check-release-license.mjs"
  },
  "dependencies": {
    "@mitumba/tokens": "0.2.1"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.86.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "0.43.1",
    "typescript": "6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
